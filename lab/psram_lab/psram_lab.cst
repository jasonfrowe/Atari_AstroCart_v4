// Tang Nano 9K, bare board: PSRAM lab
IO_LOC  "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART TX -> BL702 USB bridge (second usbserial port on the host)
IO_LOC  "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard LEDs (active low, 1.8 V bank)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// Embedded PSRAM (both dies). Locations are fixed by the package; only
// the electrical settings are given here.
IO_PORT "O_psram_ck[0]"      IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_psram_ck[1]"      IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_psram_ck_n[0]"    IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_psram_ck_n[1]"    IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_PORT "O_psram_cs_n[0]"    IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "O_psram_cs_n[1]"    IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "O_psram_reset_n[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "O_psram_reset_n[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "IO_psram_rwds[0]"   IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_rwds[1]"   IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[0]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[1]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[2]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[3]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[4]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[5]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[6]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[7]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[8]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[9]"  IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[10]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[11]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[12]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[13]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[14]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
IO_PORT "IO_psram_dq[15]" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;
