IO_PORT "d[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "d[6]" 30;
IO_PORT "d[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "d[7]" 34;
IO_PORT "d[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Control (U5, 1.8 V side)
IO_LOC  "phi2" 85;
IO_PORT "phi2" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "rw" 86;
IO_PORT "rw" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "halt" 84;
IO_PORT "halt" IO_TYPE=LVCMOS18 PULL_MODE=UP;
// Q1 gate (T_IRQ net): with the bodge, 1 pulls cart HALT (pin 2) low
IO_LOC  "halt_pull" 83;
IO_PORT "halt_pull" IO_TYPE=LVCMOS18 PULL_MODE=DOWN DRIVE=8;

// U3 data transceiver control
IO_LOC  "buf_dir" 40;
IO_PORT "buf_dir" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC  "buf_oe" 35;
IO_PORT "buf_oe" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// EAUD (RC filter on the PCB)
IO_LOC  "audio" 76;
IO_PORT "audio" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// microSD slot on the Tang Nano 9K (SPI mode)
IO_LOC  "sd_cs" 38;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_mosi" 37;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_sck" 36;
IO_PORT "sd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_miso" 39;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// USB UART (BL702)
IO_LOC  "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rxd" 18;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs (active low)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
