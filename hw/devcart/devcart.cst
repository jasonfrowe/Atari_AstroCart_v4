// AstroCart V4 -- Tang Nano 9K on the AstroCart_V2 PCB (+ HALT bodge).
// Generated from the KiCad netlist; see docs/HARDWARE.md. 1.8 V side of U5
// (SN74LVC8T245) = FPGA pins 79-86 -> LVCMOS18; everything else is driven by
// 3.3 V SN74LVC245s -> LVCMOS33.

IO_LOC  "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "a[0]" 41;
IO_PORT "a[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
